import { useEffect, useState } from 'react';
import { request } from '../api';

export default function Products() {
  const [items, setItems] = useState([]);
  const [state, setState] = useState('loading');

  useEffect(() => {
    request('/products')
      .then((d) => { setItems(d.items); setState(d.items.length ? 'ready' : 'empty'); })
      .catch(() => setState('error'));
  }, []);

  if (state === 'loading') return <p>Loading...</p>;
  if (state === 'error') return <p>Could not load products.</p>;
  if (state === 'empty') return <p>No products yet. Run `npm run seed`.</p>;

  return (
    <div className="grid">
      {items.map((p) => (
        <div className="card" key={p._id}>
          <h3>{p.name}</h3>
<% if (opts.products.categories) { %>          <small>{p.category}</small>
<% } %>          <p><%= currency %>{p.price}</p>
        </div>
      ))}
    </div>
  );
}
